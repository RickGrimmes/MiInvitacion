---
import Layout from '../layouts/Layout.astro';
import MusicPlayerWidget from '../components/MusicPlayerWidget.astro';
import CoupleGallery from '../components/CoupleGallery.astro';


const isRicardoKiara = true;
const event = { dress_code: 'Rigurosa Etiqueta / Formal' };

const coupleNames = isRicardoKiara
  ? {
      groom: 'MARTÍN RICARDO CABELLO RODRÍGUEZ',
      bride: 'KIARA DELGADILLO TORRES',
      shortTitle: 'Ricardo & Kiara',
      formalDate: 'Viernes, 2 de Abril de 2027',
      targetIsoDate: '2027-04-02T17:30:00',
    }
  : {
      groom: 'CARLOS MORALES',
      bride: 'SOFÍA GARZA',
      shortTitle: event.title,
      formalDate: 'Domingo, 25 de Octubre de 2026',
      targetIsoDate: event.event_date || '2026-10-25T18:00:00',
    };

// Mensajes y contactos directos para confirmar con Ricardo o con Kiara
const waTextRicardo = encodeURIComponent(
  'Hola Ricardo, te escribo por la invitación de su boda para confirmar mi asistencia.'
);
const waTextKiara = encodeURIComponent(
  'Hola Kiara, te escribo por la invitación de su boda para confirmar mi asistencia.'
);
const phoneRicardo = '528711234567';
const phoneKiara = '528719876543';
const waUrlRicardo = `https://wa.me/${phoneRicardo}?text=${waTextRicardo}`;
const waUrlKiara = `https://wa.me/${phoneKiara}?text=${waTextKiara}`;

// Enlace directo a Google Calendar (Viernes 2 de Abril de 2027, 17:00 hrs a 02:00 hrs)
const gcalTitle = encodeURIComponent(`Boda de ${coupleNames.shortTitle}`);
const gcalDetails = encodeURIComponent(
  `Ceremonia Religiosa (5:30 PM): Parroquia de San Pedro Apóstol, Calzada Mónaco 485, Torreón.\nRecepción (9:00 PM): Centro de Convenciones San Ángel, Av. Lerdo de Tejada, Torreón.`
);
const gcalLocation = encodeURIComponent('Parroquia de San Pedro Apóstol, Calzada Mónaco 485, Torreón, Coahuila');
const googleCalendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${gcalTitle}&dates=20270402T173000/20270403T020000&details=${gcalDetails}&location=${gcalLocation}&ctz=America/Monterrey`;

// Fotografías principales de portada en arco (3 fotos con difuminado automático)
const heroSlides = [
  {
    src: '/images/hero1.jpeg',
    alt: 'Ricardo y Kiara — Portada 1',
  },
  {
    src: '/images/hero2.jpeg',
    alt: 'Ricardo y Kiara — Portada 2',
  },
  {
    src: '/images/hero3.jpeg',
    alt: 'Ricardo y Kiara — Portada 3',
  },
];

// Itinerario
const itineraryList = isRicardoKiara
  ? [
      { time: '5:30 PM', title: 'Ceremonia Religiosa', desc: 'Solemne misa en Parroquia de San Pedro Apóstol' },
      { time: '9:00 PM', title: 'Recepción y Fiesta', desc: 'Bienvenida y celebración en Centro de Convenciones San Ángel' },
      { time: '10:00 PM', title: 'Banquete y Cena', desc: 'Cena formal en honor a los novios' },
      { time: '2:00 AM', title: 'Fin de la Celebración', desc: 'Despedida y cierre de una noche inolvidable' },
    ]
  : [
      { time: '18:00 hrs', title: 'Ceremonia Religiosa', desc: 'Capilla Principal' },
      { time: '19:30 hrs', title: 'Cóctel de Bienvenida', desc: 'Jardín Central' },
      { time: '21:00 hrs', title: 'Recepción y Cena', desc: 'Salón Principal' },
      { time: '23:00 hrs', title: 'Fiesta', desc: 'Celebración' },
    ];
---

<Layout title={`${coupleNames.shortTitle} — Invitación de Boda`} theme="editorial">

  <!-- Fondo general con matiz crema cálido de la paleta -->
  <div class="min-h-screen bg-[#FAF8F0] text-[#233120]">
    <main class="mx-auto max-w-lg pb-24">
      
      <!-- Portada Fotográfica 100% de ancho, más larga, tocando el techo y con forma de arco arriba -->
      <div
        id="hero-arch-container"
        class="relative h-[535px] sm:h-[585px] w-full overflow-hidden rounded-t-full"
        style="-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 62%, transparent 94%); mask-image: linear-gradient(to bottom, #000 0%, #000 62%, transparent 94%);"
      >
        {heroSlides.map((slide, index) => (
          <img
            src={slide.src}
            alt={slide.alt}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'low'}
            decoding="async"
            data-hero-slide={index}
            class:list={[
              'hero-crossfade-slide absolute inset-x-0 top-0 h-[calc(100%-16px)] w-full object-cover object-center transition-all duration-[1600ms] ease-in-out',
              index === 0 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-105 z-0',
            ]}
          />
        ))}
      </div>

      <div class="px-5">
      <!-- Hero Editorial de Alta Gama -->
      <header class="inv-reveal relative z-30 -mt-3 text-center">
        <span class="block text-sm sm:text-base font-bold tracking-[0.35em] text-[#608B56] uppercase">
          Nuestra Boda
        </span>

        <!-- Nombres de los Novios -->
        <div class="mt-4 space-y-2">
          <h1 class="font-serif text-3xl font-normal tracking-wide text-[#233120] uppercase sm:text-4xl leading-snug">
            {coupleNames.groom}
          </h1>
          <div class="flex items-center justify-center gap-4 py-1">
            <div class="inv-line-grow h-0.5 w-16 bg-gradient-to-r from-transparent to-[#C5A059]"></div>
            <span class="font-serif text-3xl italic text-[#C5A059]">&</span>
            <div class="inv-line-grow h-0.5 w-16 bg-gradient-to-l from-transparent to-[#C5A059]"></div>
          </div>
          <h2 class="font-serif text-3xl font-normal tracking-wide text-[#233120] uppercase sm:text-4xl leading-snug">
            {coupleNames.bride}
          </h2>
        </div>

        <!-- Fecha formal -->
        <p class="mt-5 font-serif text-2xl sm:text-3xl italic font-medium text-[#608B56]">
          {coupleNames.formalDate}
        </p>

        <!-- Mensaje de honor -->
        <div class="mx-auto mt-7 max-w-md border-t-2 border-b-2 border-[#C5A059]/40 bg-[#E6DEA6]/20 rounded-2xl py-6 px-4">
          <p class="font-serif text-xl sm:text-2xl leading-relaxed text-[#2C3E28] italic">
            "Con la bendición de Dios y de nuestras familias, tenemos el honor de invitarte a celebrar con nosotros el inicio de nuestro matrimonio."
          </p>
        </div>
      </header>

      <!-- Cuenta Regresiva en Tonos Verde Bosque, Salvia y Dorado + Agendar en Calendario -->
      <section class="inv-reveal mt-12 relative overflow-hidden rounded-3xl bg-[#2C3E28] p-2 shadow-xl ring-2 ring-[#C5A059]/50">
        <!-- Fotografía sutil de fondo con velo verde bosque profundo -->
        <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-3xl">
          <img
            src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=600&q=70"
            alt=""
            class="h-full w-full object-cover opacity-20 scale-105"
            loading="lazy" decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-[#2C3E28]/90 via-[#385233]/88 to-[#243320]/95"></div>
        </div>

        <!-- Marco interior con borde dorado/champaña -->
        <div class="relative z-10 rounded-[22px] border border-[#DCD888]/45 px-5 py-8 text-center">
          
          <div class="flex items-center justify-center gap-3">
            <div class="inv-line-grow h-0.5 w-10 bg-[#DCD888]/60"></div>
            <span class="text-sm font-bold tracking-[0.32em] text-[#DCD888] uppercase">
              Reserva la Fecha
            </span>
            <div class="inv-line-grow h-0.5 w-10 bg-[#DCD888]/60"></div>
          </div>

          <h3 class="mt-2 font-serif text-3xl sm:text-4xl font-normal text-[#FAF8F0]">
            Faltan Sólo
          </h3>
          <p class="mt-1.5 font-serif text-base sm:text-lg italic text-[#E6DEA6]">
            Para el inicio de nuestro para siempre
          </p>

          <!-- Tarjetas de Tiempo con Efecto Cristal Verde/Dorado -->
          <div id="countdown-grid" class="mt-7 grid grid-cols-4 gap-2.5">
            <div class="inv-stagger-item flex flex-col items-center justify-center rounded-2xl border border-[#DCD888]/35 bg-[#FAF8F0]/10 py-4 px-1.5 backdrop-blur-md shadow-inner" style="transition-delay: 80ms;">
              <span id="cd-days" class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-[#FAF8F0]">00</span>
              <span class="mt-1.5 text-xs font-bold tracking-[0.18em] text-[#DCD888] uppercase">Días</span>
            </div>
            <div class="inv-stagger-item flex flex-col items-center justify-center rounded-2xl border border-[#DCD888]/35 bg-[#FAF8F0]/10 py-4 px-1.5 backdrop-blur-md shadow-inner" style="transition-delay: 160ms;">
              <span id="cd-hours" class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-[#FAF8F0]">00</span>
              <span class="mt-1.5 text-xs font-bold tracking-[0.18em] text-[#DCD888] uppercase">Horas</span>
            </div>
            <div class="inv-stagger-item flex flex-col items-center justify-center rounded-2xl border border-[#DCD888]/35 bg-[#FAF8F0]/10 py-4 px-1.5 backdrop-blur-md shadow-inner" style="transition-delay: 240ms;">
              <span id="cd-minutes" class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-[#FAF8F0]">00</span>
              <span class="mt-1.5 text-xs font-bold tracking-[0.18em] text-[#DCD888] uppercase">Min</span>
            </div>
            <div class="inv-stagger-item flex flex-col items-center justify-center rounded-2xl border border-[#DCD888]/35 bg-[#FAF8F0]/10 py-4 px-1.5 backdrop-blur-md shadow-inner" style="transition-delay: 320ms;">
              <span id="cd-seconds" class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-[#DCD888]">00</span>
              <span class="mt-1.5 text-xs font-bold tracking-[0.18em] text-[#E6DEA6] uppercase">Seg</span>
            </div>
          </div>

          <!-- Botón de Calendario en Dorado / Champaña -->
          <div class="mt-7 pt-6 border-t border-[#E6DEA6]/20">
            <button
              id="btn-toggle-calendar"
              type="button"
              class="inline-flex w-full sm:w-auto items-center justify-center gap-2.5 rounded-xl bg-gradient-to-r from-[#DCD888] via-[#E6DEA6] to-[#C5A059] px-7 py-4 text-sm font-bold tracking-[0.18em] text-[#1E2B1B] uppercase shadow-md transition duration-300 hover:brightness-105 active:scale-95"
            >
              <svg class="h-5 w-5 text-[#1E2B1B]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Agendar en mi Calendario</span>
            </button>

            <!-- Opciones desplegables con animación suave (Logos grandes sobre fondo claro) -->
            <div id="calendar-options-panel" class="cal-collapse-wrapper">
              <div class="cal-collapse-inner pt-2">
                <span class="block text-center text-xs font-bold tracking-[0.25em] text-[#E6DEA6] uppercase mb-2.5">
                  Agregar en:
                </span>
                <div class="grid grid-cols-2 gap-3">
                  <a
                    href={googleCalendarUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Agregar a Google Calendar"
                    title="Google Calendar"
                    class="flex items-center justify-center gap-3 rounded-2xl border-2 border-[#C5A059]/70 bg-[#FAF8F0] py-3.5 px-4 shadow-sm transition duration-200 hover:bg-[#E6DEA6]/90 active:scale-95"
                  >
                    <!-- Logo oficial de Google ("G") + Icono grande de Google Calendar -->
                    <svg class="h-9 w-9 shrink-0" viewBox="0 0 24 24">
                      <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                      <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                      <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                      <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                    <svg class="h-10 w-10 shrink-0" viewBox="0 0 24 24">
                      <rect x="3" y="4" width="18" height="17" rx="3" fill="#ffffff" stroke="#4285F4" stroke-width="1.2"/>
                      <path d="M3 8h18V7a3 3 0 00-3-3H6a3 3 0 00-3 3v1z" fill="#4285F4"/>
                      <rect x="7" y="2" width="2" height="4" rx="1" fill="#1967D2"/>
                      <rect x="15" y="2" width="2" height="4" rx="1" fill="#1967D2"/>
                      <text x="12" y="17.5" text-anchor="middle" fill="#1967D2" font-size="8.5" font-weight="bold" font-family="sans-serif">31</text>
                    </svg>
                  </a>
                  <button
                    id="btn-download-ics"
                    type="button"
                    aria-label="Agregar en Apple o Android"
                    title="Apple / Android"
                    class="flex items-center justify-center gap-3.5 rounded-2xl border-2 border-[#C5A059]/70 bg-[#FAF8F0] py-3.5 px-4 shadow-sm transition duration-200 hover:bg-[#E6DEA6]/90 active:scale-95"
                  >
                    <!-- Logo grande de Apple -->
                    <svg class="h-10 w-10 shrink-0 fill-[#233120]" viewBox="0 0 24 24">
                      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.96 6.33c.67-.81 1.12-1.94 1-3.08-.96.04-2.13.64-2.82 1.45-.61.7-.115 1.85-1.01 2.97 1.08.08 2.16-.53 2.83-1.34z"/>
                    </svg>
                    <span class="h-6 w-px bg-[#C5A059]/50"></span>
                    <!-- Logo grande de Android -->
                    <svg class="h-10 w-10 shrink-0 fill-[#78C257]" viewBox="0 0 24 24">
                      <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993.0001.5511-.4482.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.2439 13.8533 7.8508 12 7.8508s-3.5902.3931-5.1367 1.0989L4.841 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3435-4.1021-2.6892-7.5743-6.1185-9.4396"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Galería Editorial de Fotos -->
      <CoupleGallery />

      <!-- Separador Ornamental en Dorado y Verde Salvia -->
      <div class="inv-reveal my-12 flex items-center justify-center gap-3">
        <div class="inv-line-grow h-0.5 w-20 bg-gradient-to-r from-transparent to-[#C5A059]"></div>
        <span class="h-2.5 w-2.5 rotate-45 border border-[#C5A059] bg-[#DCD888]"></span>
        <div class="inv-line-grow h-0.5 w-20 bg-gradient-to-l from-transparent to-[#C5A059]"></div>
      </div>

      <!-- Ubicación: Iglesia (Ceremonia Religiosa) -->
      <section class="inv-reveal overflow-hidden rounded-3xl border-2 border-[#C5A059]/40 bg-white shadow-md transition-shadow duration-500 hover:shadow-lg">
        <!-- Fotografía del lugar -->
        <div class="relative h-56 w-full overflow-hidden bg-[#2C3E28]">
          <img
            src="/images/iglesia.jpg"
            alt="Parroquia de San Pedro Apóstol"
            class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
            loading="lazy" decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#1E2B1B]/90 via-[#1E2B1B]/30 to-transparent"></div>
          <div class="absolute bottom-4 left-5 right-5 flex items-end justify-between gap-2">
            <div>
              <span class="block text-xs font-bold tracking-[0.25em] text-[#DCD888] uppercase">
                Ceremonia Religiosa
              </span>
              <h3 class="mt-1 font-serif text-2xl sm:text-3xl font-normal text-white">
                Parroquia de San Pedro Apóstol
              </h3>
            </div>
            <span class="shrink-0 rounded-full border border-[#C5A059] bg-[#E6DEA6] px-3.5 py-1.5 text-sm font-bold text-[#233120] shadow-xs">
              5:30 PM
            </span>
          </div>
        </div>

        <div class="p-6">
          <div class="flex items-start gap-3 text-[#2C3E28]">
            <svg class="mt-1 h-5 w-5 shrink-0 text-[#608B56]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <p class="text-base sm:text-lg leading-relaxed text-[#384934]">
              Calzada Mónaco 485, Residencial San Isidro, Torreón, Coahuila, C.P. 27100.
            </p>
          </div>

          <!-- Mini mapa interactivo (carga diferida al acercarse para no bloquear el inicio) -->
          <div class="mt-5 overflow-hidden rounded-2xl border border-[#C5A059]/50 bg-[#FAF8F0] shadow-2xs">
            <iframe
              title="Mapa Parroquia de San Pedro Apóstol"
              data-map-src="https://maps.google.com/maps?q=Parroquia+de+San+Pedro+Apostol+Torreon+25.5659072,-103.4318185&t=&z=16&ie=UTF8&iwloc=&output=embed"
              class="h-48 w-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>

          <div class="mt-5">
            <span class="block text-center text-xs sm:text-sm font-bold tracking-[0.28em] text-[#8C651D] uppercase mb-3">
              Ver en:
            </span>
            <div class="grid grid-cols-2 gap-3.5">
              <a
                href="https://maps.app.goo.gl/JTh9BtxJdsrYgC7s5"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Ver en Google Maps"
                title="Google Maps"
                class="flex items-center justify-center rounded-2xl border-2 border-[#C5A059]/60 bg-[#FAF8F0] py-4 px-4 shadow-2xs transition hover:bg-[#E6DEA6]/45 active:scale-95"
              >
                <!-- Logo grande de Google Maps -->
                <svg class="h-11 w-11 shrink-0" viewBox="0 0 24 24">
                  <path fill="#EA4335" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                  <path fill="#4285F4" d="M12 2c3.87 0 7 3.13 7 7 0 2.68-2.05 6.32-4.24 9.36L12 12V2z"/>
                  <path fill="#FBBC04" d="M5 9c0 2.68 2.05 6.32 4.24 9.36L12 12 6.4 4.8C5.52 6 5 7.44 5 9z"/>
                  <path fill="#34A853" d="M12 22s4.18-4.63 6.08-8.98L12 12l-2.76 6.36C10.91 20.68 12 22 12 22z"/>
                  <circle cx="12" cy="9" r="3.2" fill="#FAF8F0"/>
                </svg>
              </a>
              <a
                href="https://waze.com/ul?ll=25.5659072,-103.4318185&navigate=yes"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Ver en Waze"
                title="Waze"
                class="flex items-center justify-center rounded-2xl border-2 border-[#C5A059]/60 bg-[#FAF8F0] py-4 px-4 shadow-2xs transition hover:bg-[#E6DEA6]/45 active:scale-95"
              >
                <!-- Logo grande de Waze -->
                <svg class="h-11 w-11 shrink-0" viewBox="0 0 24 24">
                  <path fill="#33CCFF" d="M12.5 3C7.8 3 4 6.6 4 11c0 1.9.7 3.7 1.9 5.1-.5.6-1.3 1.1-2.2 1.3-.4.1-.7.5-.6.9.1.3.3.5.6.6 1.5.3 3 .2 4.4-.2 1.3.5 2.8.8 4.4.8 4.7 0 8.5-3.6 8.5-8.5S17.2 3 12.5 3z"/>
                  <path fill="none" stroke="#1E2B1B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M12.5 3C7.8 3 4 6.6 4 11c0 1.9.7 3.7 1.9 5.1-.5.6-1.3 1.1-2.2 1.3-.4.1-.7.5-.6.9.1.3.3.5.6.6 1.5.3 3 .2 4.4-.2 1.3.5 2.8.8 4.4.8 4.7 0 8.5-3.6 8.5-8.5S17.2 3 12.5 3z"/>
                  <circle cx="10" cy="9.5" r="1.2" fill="#1E2B1B"/>
                  <circle cx="15" cy="9.5" r="1.2" fill="#1E2B1B"/>
                  <path fill="none" stroke="#1E2B1B" stroke-width="1.5" stroke-linecap="round" d="M9.8 13c.7 1 1.7 1.5 2.7 1.5s2-.5 2.7-1.5"/>
                  <circle cx="8.5" cy="19.5" r="2.2" fill="#1E2B1B"/>
