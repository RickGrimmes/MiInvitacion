<script define:vars={{ targetIsoDate: coupleNames.targetIsoDate }}>
  // Animación de aparición suave conforme bajas
  const revealElements = document.querySelectorAll('.inv-reveal');
  if ('IntersectionObserver' in window) {
    const heroHeader = document.querySelector('header.inv-reveal');
    if (heroHeader) {
      requestAnimationFrame(() => heroHeader.classList.add('is-visible'));
    }

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -7% 0px',
      }
    );

    revealElements.forEach((el) => {
      if (el !== heroHeader) {
        revealObserver.observe(el);
      }
    });
  } else {
    revealElements.forEach((el) => el.classList.add('is-visible'));
  }

  // Animación de difuminado suave entre las 3 fotos principales de portada en arco
  // Se pausa automáticamente cuando el arco sale de la vista o la pestaña está en segundo plano
  const heroArchContainer = document.getElementById('hero-arch-container');
  const heroSlidesEls = document.querySelectorAll('.hero-crossfade-slide');
  if (heroSlidesEls.length > 1) {
    let currentHeroIndex = 0;
    let heroIntervalId = null;
    let isHeroVisible = true;

    function stepHeroSlide() {
      if (document.hidden || !isHeroVisible) return;
      const prevEl = heroSlidesEls[currentHeroIndex];
      currentHeroIndex = (currentHeroIndex + 1) % heroSlidesEls.length;
      const nextEl = heroSlidesEls[currentHeroIndex];

      if (prevEl) {
        prevEl.classList.remove('opacity-100', 'scale-100', 'z-10');
        prevEl.classList.add('opacity-0', 'scale-105', 'z-0');
      }
      if (nextEl) {
        nextEl.classList.remove('opacity-0', 'scale-105', 'z-0');
        nextEl.classList.add('opacity-100', 'scale-100', 'z-10');
      }
    }

    function startHeroCycle() {
      if (!heroIntervalId) {
        heroIntervalId = setInterval(stepHeroSlide, 4500);
      }
    }

    function stopHeroCycle() {
      if (heroIntervalId) {
        clearInterval(heroIntervalId);
        heroIntervalId = null;
      }
    }

    startHeroCycle();

    if ('IntersectionObserver' in window && heroArchContainer) {
      const heroObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isHeroVisible = entry.isIntersecting;
            if (isHeroVisible) {
              startHeroCycle();
            } else {
              stopHeroCycle();
            }
          });
        },
        { threshold: 0.05 }
      );
      heroObserver.observe(heroArchContainer);
    }
  }

  // Carga diferida de mapas interactivos cuando el invitado se acerca a la sección de ubicaciones
  const lazyMaps = document.querySelectorAll('iframe[data-map-src]');
  if ('IntersectionObserver' in window && lazyMaps.length > 0) {
    const mapObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const iframe = entry.target;
            const src = iframe.getAttribute('data-map-src');
            if (src) {
              iframe.setAttribute('src', src);
              iframe.removeAttribute('data-map-src');
            }
            mapObserver.unobserve(iframe);
          }
        });
      },
      { rootMargin: '450px 0px' }
    );
    lazyMaps.forEach((iframe) => mapObserver.observe(iframe));
  } else {
    lazyMaps.forEach((iframe) => {
      const src = iframe.getAttribute('data-map-src');
      if (src) iframe.setAttribute('src', src);
    });
  }

  // Interactividad del Código de Vestimenta (Invitadas / Invitados)
  const btnDressWomen = document.getElementById('btn-dress-women');
  const btnDressMen = document.getElementById('btn-dress-men');
  const dressCollapse = document.getElementById('dress-code-collapse');
  const panelWomen = document.getElementById('dress-panel-women');
  const panelMen = document.getElementById('dress-panel-men');
  let activeDressTab = null;

  function setDressTab(tab) {
    if (!dressCollapse || !panelWomen || !panelMen || !btnDressWomen || !btnDressMen) return;

    if (activeDressTab === tab) {
      // Si vuelve a presionar el mismo botón activo, se cierra suavemente
      activeDressTab = null;
      dressCollapse.classList.remove('is-open');
      btnDressWomen.classList.remove('ring-2', 'ring-[#608B56]', 'bg-[#A3C184]/20');
      btnDressMen.classList.remove('ring-2', 'ring-[#608B56]', 'bg-[#A3C184]/20');
      btnDressWomen.querySelector('.dress-chevron')?.classList.remove('rotate-180');
      btnDressMen.querySelector('.dress-chevron')?.classList.remove('rotate-180');
      btnDressWomen.setAttribute('aria-expanded', 'false');
      btnDressMen.setAttribute('aria-expanded', 'false');
      return;
    }

    activeDressTab = tab;
    dressCollapse.classList.add('is-open');

    if (tab === 'women') {
      panelWomen.classList.remove('hidden');
      panelMen.classList.add('hidden');
      btnDressWomen.classList.add('ring-2', 'ring-[#608B56]', 'bg-[#A3C184]/20');
      btnDressMen.classList.remove('ring-2', 'ring-[#608B56]', 'bg-[#A3C184]/20');
      btnDressWomen.querySelector('.dress-chevron')?.classList.add('rotate-180');
      btnDressMen.querySelector('.dress-chevron')?.classList.remove('rotate-180');
      btnDressWomen.setAttribute('aria-expanded', 'true');
      btnDressMen.setAttribute('aria-expanded', 'false');
    } else {
      panelMen.classList.remove('hidden');
      panelWomen.classList.add('hidden');
      btnDressMen.classList.add('ring-2', 'ring-[#608B56]', 'bg-[#A3C184]/20');
      btnDressWomen.classList.remove('ring-2', 'ring-[#608B56]', 'bg-[#A3C184]/20');
      btnDressMen.querySelector('.dress-chevron')?.classList.add('rotate-180');
      btnDressWomen.querySelector('.dress-chevron')?.classList.remove('rotate-180');
      btnDressMen.setAttribute('aria-expanded', 'true');
      btnDressWomen.setAttribute('aria-expanded', 'false');
    }
  }

  btnDressWomen?.addEventListener('click', () => setDressTab('women'));
  btnDressMen?.addEventListener('click', () => setDressTab('men'));

  // Mostrar / ocultar opciones de calendario y descargar archivo .ics
  const btnToggleCal = document.getElementById('btn-toggle-calendar');
  const calPanel = document.getElementById('calendar-options-panel');
  const btnDownloadIcs = document.getElementById('btn-download-ics');

  btnToggleCal?.addEventListener('click', () => {
    if (!calPanel) return;
    calPanel.classList.toggle('is-open');
  });

  btnDownloadIcs?.addEventListener('click', () => {
    const icsContent = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//Ricardo y Kiara//Invitacion de Boda//ES',
      'CALSCALE:GREGORIAN',
      'METHOD:PUBLISH',
      'BEGIN:VEVENT',
      'UID:boda-ricardo-y-kiara-2027@invitacion',
      'SUMMARY:Boda de Ricardo & Kiara',
      'DTSTART:20270402T173000',
      'DTEND:20270403T020000',
      'LOCATION:Parroquia de San Pedro Apóstol, Calzada Mónaco 485, Torreón, Coahuila',
      'DESCRIPTION:Ceremonia Religiosa (5:30 PM): Parroquia de San Pedro Apóstol. Recepción (9:00 PM): Centro de Convenciones San Ángel, Torreón.',
      'STATUS:CONFIRMED',
      'BEGIN:VALARM',
      'TRIGGER:-P1D',
      'ACTION:DISPLAY',
      'DESCRIPTION:Mañana es la Boda de Ricardo & Kiara',
      'END:VALARM',
      'END:VEVENT',
      'END:VCALENDAR',
    ].join('\r\n');

    const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', 'boda-ricardo-y-kiara.ics');
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

    if (window.showInAppToast) {
      window.showInAppToast('Evento listo para guardar en tu calendario', 'success');
    }
  });

  // Copiar CLABE al portapapeles para cualquiera de las dos cuentas
  document.querySelectorAll('.btn-copy-clabe-item').forEach((btn) => {
    btn.addEventListener('click', () => {
      const clabe = btn.getAttribute('data-copy-clabe') || '';
      const owner = btn.getAttribute('data-copy-owner') || '';
      if (navigator.clipboard && clabe) {
        navigator.clipboard.writeText(clabe).then(() => {
          if (window.showInAppToast) {
            window.showInAppToast(`CLABE de ${owner} copiada al portapapeles`, 'success');
          }
        }).catch(() => {
          if (window.showInAppToast) {
            window.showInAppToast('No se pudo copiar automáticamente', 'error');
          }
        });
      }
    });
  });

  // Cuenta regresiva precisa con referencias en caché y actualización selectiva del DOM
  const targetTime = new Date(targetIsoDate).getTime();
  const elD = document.getElementById('cd-days');
  const elH = document.getElementById('cd-hours');
  const elM = document.getElementById('cd-minutes');
  const elS = document.getElementById('cd-seconds');
  let prevD = '';
  let prevH = '';
  let prevM = '';
  let prevS = '';
  const pad = (n) => String(n).padStart(2, '0');

  function updateCountdown() {
    const diff = targetTime - Date.now();

    if (diff <= 0) {
      if (elD && prevD !== '00') { elD.textContent = '00'; prevD = '00'; }
      if (elH && prevH !== '00') { elH.textContent = '00'; prevH = '00'; }
      if (elM && prevM !== '00') { elM.textContent = '00'; prevM = '00'; }
      if (elS && prevS !== '00') { elS.textContent = '00'; prevS = '00'; }
      return;
    }

    const dStr = pad(Math.floor(diff / 86400000));
    const hStr = pad(Math.floor((diff % 86400000) / 3600000));
    const mStr = pad(Math.floor((diff % 3600000) / 60000));
    const sStr = pad(Math.floor((diff % 60000) / 1000));

    if (elD && dStr !== prevD) { elD.textContent = dStr; prevD = dStr; }
    if (elH && hStr !== prevH) { elH.textContent = hStr; prevH = hStr; }
    if (elM && mStr !== prevM) { elM.textContent = mStr; prevM = mStr; }
    if (elS && sStr !== prevS) { elS.textContent = sStr; prevS = sStr; }
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
